# =========================================================
# 🌐 SITE
# =========================================================

SECRET_KEY=change-this-to-a-long-random-secret-key

SITE_NAME=Bumpify
SITE_URL=http://localhost:5000
SITE_DESCRIPTION=Discord server bumping platform.
SITE_LOGO=/static/img/logo.png

# =========================================================
# 🗄️ DATABASE
# =========================================================

DATABASE_URL=sqlite:///website.db

# Pour PostgreSQL en production :
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# =========================================================
# 🤖 DISCORD BOT
# =========================================================

DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN
DISCORD_CLIENT_ID=YOUR_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Lien d'invitation du bot
DISCORD_BOT_INVITE_URL=https://discord.com/oauth2/authorize?client_id=YOUR_CLIENT_ID&permissions=YOUR_PERMISSIONS&scope=bot%20applications.commands

# =========================================================
# 🔐 DISCORD OAUTH2
# =========================================================

DISCORD_REDIRECT_URI=http://localhost:5000/auth/callback

# identify = informations utilisateur
# guilds = serveurs Discord de l'utilisateur
DISCORD_OAUTH_SCOPES=identify guilds

# =========================================================
# 👑 PANEL ADMIN
# =========================================================

ADMIN_USERNAME=admin

# Ne mets PAS le mot de passe directement ici.
# Cette valeur doit contenir un hash bcrypt.
ADMIN_PASSWORD_HASH=

# =========================================================
# 📡 API
# =========================================================

API_KEY=CHANGE_THIS_API_KEY

# =========================================================
# ⏱️ BUMP
# =========================================================

# 7200 secondes = 2 heures
BUMP_COOLDOWN=7200

# =========================================================
# 🛠️ ENVIRONNEMENT
# =========================================================

DEBUG=False
